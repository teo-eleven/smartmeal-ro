{
  "name": "smartmeal-ro",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:sql": "node scripts/checkMigrations.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage",
    "test:components": "jest --selectProjects components",
    "photos:sheet": "node scripts/photoContactSheet.mjs",
    "build:web": "expo export -p web && node scripts/injectCsp.mjs dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-purchases": "^10.10.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@electric-sql/pglite": "^0.2.17",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "~30.5.2",
    "prettier": "^3.5.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "_overridesNote": "Forteaza versiunile patch-uite ale unor dependente tranzitive de build (Expo CLI, Metro), fara a urca Expo SDK. image-size este exclus intentionat: v2 schimba forma exportului si rupe metro/src/Assets.js (getImageSize is not a function). Vezi docs/DECISIONS.md ADR-09.",
  "overrides": {
    "tar": "^7.5.22",
    "@xmldom/xmldom": "^0.9.12",
    "postcss": "^8.5.28",
    "uuid": "^11.1.1"
  }
}
