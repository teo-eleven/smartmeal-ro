{
  "expo": {
    "name": "SmartMeal RO",
    "slug": "smartmeal-ro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.smartmeal.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "ro.smartmeal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
