# SmartMeal RO Environment Configuration

# Expo Web Port (default: 8081)
EXPO_PUBLIC_PORT=8081

# Application Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# NOTE: there is deliberately no EXPO_PUBLIC_GEMINI_API_KEY here.
# Everything prefixed EXPO_PUBLIC_ is inlined into the shipped client bundle, so a model
# provider key placed there would be readable by every user of the app.
# The Gemini key belongs in Supabase secrets, used by supabase/functions/proxy-gemini-plan:
#   supabase secrets set GEMINI_API_KEY=...

# Supabase URL & Anon Key (Optional for Guest-First local mode; required for cloud sync)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
