# SmartMeal RO Environment Configuration

# Expo Web Port (default: 8081)
EXPO_PUBLIC_PORT=8081

# Application Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# Google Gemini API Key (Optional for local deterministic mode; required for AI meal swap & smart personalization)
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase URL & Anon Key (Optional for Guest-First local mode; required for cloud sync)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
